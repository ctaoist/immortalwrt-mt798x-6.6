Subject: [PATCH] r8168: detect backported ethtool EEE link mode support

The MediaTek 6.6 kernel backports the ethtool_keee interface from Linux
6.9. Version checks alone select the legacy EEE representation and cause
incompatible callback types in ethtool_ops.

Detect the interface in the kernel headers and consistently select the
existing bitmap implementation. Keep the legacy implementation for
kernels without the new interface.

--- a/src/Makefile
+++ b/src/Makefile
@@ -53,6 +53,9 @@
 ifneq ($(KERNELRELEASE),)
 	obj-m := r8168.o
 	r8168-objs := r8168_n.o r8168_asf.o rtl_eeprom.o rtltool.o
+	ifneq ($(shell grep -s 'struct ethtool_keee {' $(srctree)/include/linux/ethtool.h),)
+		EXTRA_CFLAGS += -DR8168_HAVE_ETHTOOL_KEEE
+	endif
 	ifeq ($(CONFIG_SOC_LAN), y)
 		EXTRA_CFLAGS += -DCONFIG_SOC_LAN
 	endif
--- a/src/r8168.h
+++ b/src/r8168.h
@@ -423,12 +423,12 @@
 #define  MDIO_EEE_1000T  0x0004
 #endif
 
-#if LINUX_VERSION_CODE < KERNEL_VERSION(6,9,0)
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6,9,0) && !defined(R8168_HAVE_ETHTOOL_KEEE)
 #define ethtool_keee ethtool_eee
 #define rtl8168_ethtool_adv_to_mmd_eee_adv_cap1_t ethtool_adv_to_mmd_eee_adv_t
 #else
 #define rtl8168_ethtool_adv_to_mmd_eee_adv_cap1_t linkmode_to_mii_eee_cap1_t
-#endif /* LINUX_VERSION_CODE < KERNEL_VERSION(6,9,0) */
+#endif /* ethtool_keee */
 
 #if LINUX_VERSION_CODE < KERNEL_VERSION(2,6,29)
 #ifdef CONFIG_NET_POLL_CONTROLLER
--- a/src/r8168_n.c
+++ b/src/r8168_n.c
@@ -8022,7 +8022,7 @@
         return to_us;
 }
 
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(6,9,0)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6,9,0) || defined(R8168_HAVE_ETHTOOL_KEEE)
 static void
 rtl8168_adv_to_linkmode(unsigned long *mode, u64 adv)
 {
@@ -8245,7 +8245,7 @@
 out:
         return rc;
 }
-#endif /* LINUX_VERSION_CODE >= KERNEL_VERSION(6,9,0) */
+#endif /* ethtool_keee */
 #endif /* LINUX_VERSION_CODE >= KERNEL_VERSION(3,6,0) */
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(3,0,0)
@@ -26894,7 +26894,7 @@
                 struct ethtool_keee *eee = &tp->eee;
 
                 eee->eee_enabled = eee_enable;
-#if LINUX_VERSION_CODE < KERNEL_VERSION(6,9,0)
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6,9,0) && !defined(R8168_HAVE_ETHTOOL_KEEE)
                 eee->supported  = SUPPORTED_100baseT_Full |
                                   SUPPORTED_1000baseT_Full;
                 eee->advertised = mmd_eee_adv_to_ethtool_adv_t(MDIO_EEE_1000T | MDIO_EEE_100TX);
@@ -26903,7 +26903,7 @@
                 linkmode_set_bit(ETHTOOL_LINK_MODE_1000baseT_Full_BIT, eee->supported);
                 linkmode_set_bit(ETHTOOL_LINK_MODE_100baseT_Full_BIT, eee->advertised);
                 linkmode_set_bit(ETHTOOL_LINK_MODE_1000baseT_Full_BIT, eee->advertised);
-#endif /* LINUX_VERSION_CODE < KERNEL_VERSION(6,9,0) */
+#endif /* ethtool_keee */
                 eee->tx_lpi_enabled = eee_enable;
                 eee->tx_lpi_timer = dev->mtu + ETH_HLEN + 0x20;
         }
