Subject: [PATCH] r8125: detect backported ethtool EEE link mode support

The MediaTek 6.6 kernel backports the ethtool_keee interface from Linux
6.9. Version checks alone select legacy EEE callbacks and fail to match
the kernel's ethtool_ops callback types.

Detect the interface in the kernel headers and use the existing bitmap
implementation for the private EEE state, callbacks, capability helpers
and initialization. Retain the legacy implementation on older kernels
without the backport.

--- a/src/Makefile
+++ b/src/Makefile
@@ -58,6 +58,9 @@
 ifneq ($(KERNELRELEASE),)
 	obj-m := r8125.o
 	r8125-objs := r8125_n.o rtl_eeprom.o rtltool.o
+	ifneq ($(shell grep -s 'struct ethtool_keee {' $(srctree)/include/linux/ethtool.h),)
+		EXTRA_CFLAGS += -DR8125_HAVE_ETHTOOL_KEEE
+	endif
 	ifeq ($(CONFIG_SOC_LAN), y)
 		EXTRA_CFLAGS += -DCONFIG_SOC_LAN
 	endif
--- a/src/r8125.h
+++ b/src/r8125.h
@@ -488,7 +488,7 @@
 #define  MDIO_EEE_2_5GT  0x0001
 #endif
 
-#if LINUX_VERSION_CODE < KERNEL_VERSION(6,9,0)
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6,9,0) && !defined(R8125_HAVE_ETHTOOL_KEEE)
 #define ethtool_keee ethtool_eee
 #define rtl8125_ethtool_adv_to_mmd_eee_adv_cap1_t ethtool_adv_to_mmd_eee_adv_t
 static inline u32 rtl8125_ethtool_adv_to_mmd_eee_adv_cap2_t(u32 adv)
@@ -503,7 +503,7 @@
 #else
 #define rtl8125_ethtool_adv_to_mmd_eee_adv_cap1_t linkmode_to_mii_eee_cap1_t
 #define rtl8125_ethtool_adv_to_mmd_eee_adv_cap2_t linkmode_to_mii_eee_cap2_t
-#endif /* LINUX_VERSION_CODE < KERNEL_VERSION(6,9,0) */
+#endif /* ethtool_keee */
 
 #if LINUX_VERSION_CODE < KERNEL_VERSION(2,6,29)
 #ifdef CONFIG_NET_POLL_CONTROLLER
--- a/src/r8125_n.c
+++ b/src/r8125_n.c
@@ -7249,7 +7249,7 @@
         return to_us;
 }
 
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(6,9,0)
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6,9,0) || defined(R8125_HAVE_ETHTOOL_KEEE)
 static void
 rtl8125_adv_to_linkmode(unsigned long *mode, u64 adv)
 {
@@ -7515,7 +7515,7 @@
 
         return rc;
 }
-#endif /* LINUX_VERSION_CODE >= KERNEL_VERSION(6,9,0) */
+#endif /* ethtool_keee */
 #endif /* LINUX_VERSION_CODE >= KERNEL_VERSION(3,6,0) */
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(3,0,0)
@@ -15349,7 +15349,7 @@
                 struct ethtool_keee *eee = &tp->eee;
 
                 eee->eee_enabled = eee_enable;
-#if LINUX_VERSION_CODE < KERNEL_VERSION(6,9,0)
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6,9,0) && !defined(R8125_HAVE_ETHTOOL_KEEE)
                 eee->supported  = SUPPORTED_100baseT_Full |
                                   SUPPORTED_1000baseT_Full;
                 eee->advertised = mmd_eee_adv_to_ethtool_adv_t(MDIO_EEE_1000T | MDIO_EEE_100TX);
@@ -15382,7 +15382,7 @@
                         }
                         break;
                 }
-#endif /* LINUX_VERSION_CODE < KERNEL_VERSION(6,9,0) */
+#endif /* ethtool_keee */
                 eee->tx_lpi_enabled = eee_enable;
                 eee->tx_lpi_timer = dev->mtu + ETH_HLEN + 0x20;
         }
