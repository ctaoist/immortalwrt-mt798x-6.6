. /lib/functions/caldata.sh
. /lib/functions/system.sh

caldata_validate() {
	local macprefix

	[ -e "/lib/firmware/$FIRMWARE" ] || return 1

	macprefix=$(hexdump -v -n 2 -s 4 -e '1/1 "%02x:" "%02x"' "/lib/firmware/$FIRMWARE" 2>"/dev/null")
	if [ "$macprefix" = "00:0c" ] || [ -z "$macprefix" ]; then
		return 1
	else
		return 0
	fi
}

mtwifi_extract_sl3000() {
	local part image=/tmp/mtwifi-sl3000-eeprom size chip

	[ -f /etc/wireless/l1profile.dat ] || return 0
	part=$(find_mmc_part factory)
	[ -n "$part" ] || return 1
	dd if="$part" of="$image" bs=131072 count=16 2>/dev/null || return 1
	size=$(wc -c < "$image")
	[ "$size" -ge 20480 ] || return 1
	chip=$(hexdump -v -n 2 -e '2/1 "%02x"' "$image")
	[ "$chip" = "8179" ] || return 1
	ln -sf "$image" /lib/firmware/e2p
	ln -sf "$image" /lib/firmware/MT7981_iPAiLNA_EEPROM.bin
}

do_extract_caldata() {
	case $(board_name) in
	sl,3000-emmc)
		mtwifi_extract_sl3000 || echo "mt_wifi: failed to read SL3000 factory EEPROM" >&2
		;;
	cmcc,xr30-emmc |\
	cmcc,rax3000m-emmc-mtk)
		FIRMWARE=MT7981_iPAiLNA_EEPROM.bin
		caldata_validate && exit 0
		caldata_extract_mmc "factory" 0x0 0x1000
		;;
	glinet,gl-mt6000|\
	jdcloud,re-cp-03)
		FIRMWARE=MT7986_ePAeLNA_EEPROM_AX6000.bin
		caldata_validate && exit 0
		caldata_extract_mmc "factory" 0x0 0x1000
		;;
	esac
}

boot_hook_add preinit_main do_extract_caldata
